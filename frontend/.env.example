# Copy to .env for local dev: cp .env.example .env
# IMPORTANT: must end with /api
VITE_API_BASE_URL=http://localhost:3000/api
# For production deployment on Render, set this EXACT value
# as an Environment Variable on the frontend static site
# and then REDEPLOY (Vite bakes it in at build time):
# VITE_API_BASE_URL=https://out-patient-departmnet.onrender.com/api
